{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCodeDeployAgentToPullArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_ARTIFACT_BUCKET_NAME",
        "arn:aws:s3:::YOUR_ARTIFACT_BUCKET_NAME/*",
        "arn:aws:s3:::aws-codedeploy-*/*"
      ]
    }
  ]
}
