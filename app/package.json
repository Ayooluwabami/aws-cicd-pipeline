{
  "name": "aws-cicd-sample-app",
  "version": "2.0.0",
  "description": "Deployment record app (TypeScript) shipped through an AWS DevSecOps pipeline (CodePipeline, CodeBuild, CodeDeploy)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "pretest": "npm run build",
    "test": "node --test dist/*.test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws-xray-sdk-core": "^3.10.1",
    "aws-xray-sdk-express": "^3.10.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  }
}
